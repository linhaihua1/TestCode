generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id           String          @id @default(cuid())
  name         String
  description  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  environments Environment[]
  apis         ApiDefinition[]
  scenarios    Scenario[]
  reports      Report[]
  uiTests      UiTestCase[]
  uiReports    UiReport[]
  uiScenarios  UiScenario[]
  globalVariables GlobalVariable[]
  modules         Module[]
  cases           CaseInfo[]
  testTasks       TestTask[]
}

model Environment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  baseUrl   String?
  variables Json     @default("[]")
  headers   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiDefinition {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  method       String
  path         String
  headers      Json      @default("[]")
  query        Json      @default("[]")
  body         String?
  description  String?
  mockEnabled  Boolean   @default(false)
  mockResponse String?
  moduleId     String?
  tags         Json      @default("[]")
  cases        ApiCase[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ApiCase {
  id         String         @id @default(cuid())
  apiId      String
  api        ApiDefinition  @relation(fields: [apiId], references: [id], onDelete: Cascade)
  name       String
  assertions Json           @default("[]")
  extracts   Json           @default("[]")
  // 用例内部的多步骤定义（每步引用接口 + 断言 + 提取）；为空则退化为单接口用例
  stepDefs   Json           @default("[]")
  steps      ScenarioStep[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Scenario {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  steps       ScenarioStep[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ScenarioStep {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  order      Int
  apiCaseId  String?
  apiCase    ApiCase? @relation(fields: [apiCaseId], references: [id], onDelete: SetNull)
  name       String?
  assertions Json     @default("[]")
  extracts   Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Report {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarioId String?
  name       String
  status     String
  duration   Int
  startedAt  DateTime       @default(now())
  details    ReportDetail[]
}

model ReportDetail {
  id         String  @id @default(cuid())
  reportId   String
  report     Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  stepName   String
  status     String
  error      String?
  assertions Json    @default("[]")
  extracts   Json    @default("[]")
}

// 系统用户（登录认证）
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// UI 自动化测试用例（一组浏览器操作步骤，含前置/测试/后置三段式）
model UiTestCase {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  baseUrl       String?
  setupSteps    Json     @default("[]")
  steps         Json     @default("[]")
  teardownSteps Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  scenarioSteps UiScenarioStep[]
}

// UI 自动化测试报告（一次执行的完整结果）
model UiReport {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCaseId String?
  name       String
  status     String
  duration   Int
  startedAt  DateTime @default(now())
  details    Json     @default("[]")
}

// UI 自动化执行场景（组合多个 UI 用例，按业务流程顺序执行）
model UiScenario {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  steps       UiScenarioStep[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// UI 执行场景中的步骤（引用一个 UI 用例，按 order 排序）
model UiScenarioStep {
  id           String      @id @default(cuid())
  scenarioId   String
  scenario     UiScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  order        Int
  uiTestCaseId String?
  uiTestCase   UiTestCase? @relation(fields: [uiTestCaseId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model GlobalVariable {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  type String @default("string")
  value String @default("")
  encrypted Boolean @default(false)
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Module {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId String?
  parent Module? @relation("ModuleChain", fields: [parentId], references: [id])
  children Module[] @relation("ModuleChain")
  name String
  type String @default("case")
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases CaseInfo[]
}
model CaseInfo {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId String?
  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  name String
  description String?
  status String @default("draft")
  priority String @default("P2")
  tags Json @default("[]")
  steps Json @default("[]")
  version Int @default(1)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  versions CaseVersion[]
  debugRecords DebugRecord[]
  reviews CaseReview[]
}
model CaseVersion {
  id String @id @default(cuid())
  caseId String
  case CaseInfo @relation(fields: [caseId], references: [id], onDelete: Cascade)
  version Int
  snapshot Json
  changeSummary String?
  createdBy String?
  createdAt DateTime @default(now())
}
model DebugRecord {
  id String @id @default(cuid())
  caseId String
  caseInfo CaseInfo @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseNameSnapshot String
  environmentId String?
  executeMode String @default("local")
  result String @default("pending")
  totalDuration Int @default(0)
  requestSummary Json @default("[]")
  responseSummary Json @default("[]")
  assertionResults Json @default("[]")
  extractedVariables Json @default("[]")
  errorLog String?
  stepResults Json @default("[]")
  createdBy String?
  createdAt DateTime @default(now())
}

model CaseReview {
  id String @id @default(cuid())
  caseId String
  caseInfo CaseInfo @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewerName String?
  action String
  comment String?
  fromStatus String?
  toStatus String?
  createdAt DateTime @default(now())
}
model TestTask {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  description String?
  caseIds Json @default("[]")
  environmentId String?
  executeMode String @default("sequential")
  retryCount Int @default(0)
  timeout Int @default(300000)
  cronExpr String?
  enabled Boolean @default(true)
  notifyUrl String?
  variables Json @default("[]")
  baseUrl String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  runs TestTaskRun[]
}
model TestTaskRun {
  id String @id @default(cuid())
  taskId String
  task TestTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  result String @default("pending")
  duration Int @default(0)
  startedAt DateTime @default(now())
  endedAt DateTime?
  details Json @default("[]")
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entityType String
  entityId String?
  before Json?
  after Json?
  ip String?
  createdAt DateTime @default(now())
}
