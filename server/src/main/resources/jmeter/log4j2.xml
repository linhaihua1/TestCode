<?xml version="1.0" encoding="UTF-8"?>
<!--
    JMeter initLogging() 会通过 -Dlog4j2.configurationFile 指向本文件，从而覆盖
    Spring Boot 默认的 log4j2.xml。这里我们模拟一个等价的配置：业务包 INFO、JMeter 内部 WARN。
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT" follow="true">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.apiweb" level="INFO"/>
        <Logger name="org.springframework" level="WARN"/>
        <Logger name="org.apache.ibatis" level="WARN"/>
        <Logger name="org.apache.jmeter" level="WARN"/>
        <Logger name="org.apache.commons" level="WARN"/>
        <Logger name="org.apache.http" level="WARN"/>
        <Logger name="org.apache.jorphan" level="WARN"/>
        <Logger name="kg.apc" level="WARN"/>
        <Logger name="com.zaxxer.hikari" level="WARN"/>
        <Logger name="com.baomidou.mybatisplus" level="WARN"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
