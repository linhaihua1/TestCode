# 前端环境变量示例：复制为 .env.local 后按环境修改（.env.local 不入库）
# 所有变量必须以 VITE_ 前缀才会暴露给前端代码。

# 后端 API 前缀（默认 /api/v1，由 vite dev proxy 转发到 http://localhost:8080）
# 生产环境部署到独立域名时填写完整地址，例如 https://api.example.com/api/v1
VITE_API_BASE=/api/v1

# 请求超时（毫秒），默认 60000
VITE_API_TIMEOUT=60000

# 登录页是否预填演示账号（默认 false；仅本地演示用，生产必须为 false）
VITE_PREFILL_DEMO_ACCOUNT=false
VITE_DEMO_USERNAME=
VITE_DEMO_PASSWORD=

# 登录页底部的演示账号提示文案（留空则不显示该行）。
# 生产环境必须留空，避免在登录页公开默认口令。
VITE_DEMO_HINT=
